cabal-version:      2.4
name:               ett-probe
version:            0.1.0.0
synopsis:           Outbound HTTPS probe for the euler-api-gateway TLS debug forks
build-type:         Simple

executable ett-probe
    main-is:          Main.hs
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts
    build-depends:
        base >=4 && <5
      , bytestring
      , data-default-class
      , crypton-connection
      , http-client
      , http-client-tls
      , tls
